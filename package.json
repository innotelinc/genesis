{
  "name": "genesis",
  "version": "0.1.0",
  "private": true,
  "description": "Genesis — BusinessOps platform. Business formation, filing preparation, and registration orchestration for the Innotel Platform Stack.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "HOSTNAME=0.0.0.0 next dev -p 3000",
    "build": "next build",
    "start": "HOSTNAME=0.0.0.0 next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "seed": "node scripts/seed.mjs",
    "forms": "node scripts/fetch-forms.mjs",
    "forms:check": "node scripts/fetch-forms.mjs --check",
    "describe-form": "node scripts/describe-form.mjs",
    "forms:review": "tsc -p tsconfig.test.json && node scripts/review-ss4-mapping.mjs",
    "check-integrations": "node scripts/check-integrations.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
