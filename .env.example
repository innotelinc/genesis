# ==========================================================================
# genesis — environment configuration template
# Copy to `.env` (or run ./scripts/setup.sh) and fill in real values.
# Never commit `.env`. Production secrets come from Cerulean Vault (SecretOps).
# ==========================================================================

# --- General ----------------------------------------------------------------
APP_NAME=genesis
# Public hosts (DNS + TLS provisioned by Cerulean / NPM Edge)
BASE_DOMAIN=genesis.innotel.us

# --- OmniRoute (model gateway — OpenAI-compatible, single provider pool) ----
# The platform runs ONE OmniRoute, on the trust/edge host (i1, `192.168.1.71`),
# where it moved with Cerulean on 2026-09-28. Reach it at that host's LAN address
# on :20128 — OmniRoute serves its OpenAI-compatible API and its dashboard from
# that single port. Never 127.0.0.1: inside a container that is the container
# itself, which is how this default used to fail silently. The old mesh address
# (`10.10.2.1`, the Group-2 `2-voice` arrangement) no longer answers.
MESH_GATEWAY_HOST=192.168.1.71
OMNIROUTE_BASE_URL=http://192.168.1.71:20128/v1
OMNIROUTE_API_KEY=change-me-omniroute-api-key
OMNIROUTE_MODEL=auto

# --- Authentik (OIDC identity provider — Cerulean's Authentik) --------------
OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/genesis/
OIDC_CLIENT_ID=genesis
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_REDIRECT_URI=https://genesis.innotel.us/api/auth/callback

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS) ----------------------------
# Live deployments (Innotel Platform Stack hosts):
#   trust/edge 192.168.1.71 — Cerulean :3003, Authentik :9000, Cerulean Vault
#     :8200, Technitium :5380, the NPM edge (:80/:443/:81) and the estate's
#     OmniRoute gateway door :20128
#   voice host 192.168.1.30:3000 (Zeus) · build host 192.168.1.31
#   public: cerulean.innotel.us · magnate.innotel.us · app.zeus.innotel.us
# Cerulean, Authentik, NPM, Vault and Technitium all moved off 192.168.1.46 to
# 192.168.1.71. Use the LAN address, not 127.0.0.1 — inside a container that is
# the container itself.
CERULEAN_DNS_API_URL=http://192.168.1.71:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_ZONE=innotel.us

# --- Cerulean Vault (SecretOps — HashiCorp Vault, KV v2) --------------------
# The platform runs it as `cerulean-vault`; this repo gets a path-scoped
# `genesis` policy. Values in this file may be `vault://<mount>/<path>#<key>`
# references resolved at startup, e.g.
#   OMNIROUTE_API_KEY=vault://cerulean/genesis#OMNIROUTE_API_KEY
VAULT_ADDR=
VAULT_TOKEN=
# Preferred over VAULT_TOKEN: a file both the Vault CLI and this stack read.
VAULT_TOKEN_FILE=./data/vault/token/genesis.token
VAULT_PREFIX=cerulean
VAULT_PATH=genesis
VAULT_NAMESPACE=
# "1" accepts a self-signed certificate; VAULT_CACERT pins a CA instead.
VAULT_SKIP_VERIFY=
VAULT_CACERT=

# --- Magnate billing (RevenueOps — optional paid seats) ---------------------
MAGNATE_URL=https://magnate.innotel.us
ENTITLEMENTS_API_TOKEN=
# When set, must equal Magnate's ENTITLEMENTS_API_TOKEN.
# Empty = billing APIs are open on a trusted net.
# Optional: an endpoint that creates a subscription for a client. Unset means the
# billing step hands the operator the Magnate storefront instead.
MAGNATE_SUBSCRIPTION_URL=
MAGNATE_API_TOKEN=
GENESIS_PLAN=genesis

# --- Genesis (this platform) ------------------------------------------------
# Signs the session cookie. openssl rand -base64 32. Required in production.
SESSION_SECRET=
# Public origin, and the redirect URI's base as the browser sees it.
NEXT_PUBLIC_URL=https://genesis.innotel.us
# Authentik groups whose members are operators (they see every client).
GENESIS_ADMIN_GROUPS=genesis-admins
# "1" admits a single local demo identity when OIDC is not configured. Never set
# this on a production host: it bypasses Authentik entirely.
GENESIS_DEV_AUTH=

# --- Cerulean service bridge (DNS / proxy hosts / TLS for the client zones) --
# A scoped key (Bearer ceru_…) for /api/service/*. The routes Genesis uses are
# POST /api/service/domains, POST /api/service/certificates and
# POST|PUT|GET /api/service/npm/hosts, so the key needs `domains:write`,
# `certs:write`, `npm:read` and `npm:write` (`*` also works). Genesis never calls
# BIND or the NPM API directly — Cerulean is the only component that does
# (conformity standard §5).
CERULEAN_SERVICE_KEY=
CERULEAN_DNS_PROVIDER=rfc2136
# Where Cerulean points the client's proxy host. Both are required to publish the
# name: with either unset, the step stops at `awaiting_human` after registering
# the zone and issuing the certificate, rather than putting a name on the edge
# that answers nothing. LAN addresses only — NPM upstreams never use loopback.
NPM_FORWARD_HOST=
NPM_FORWARD_PORT=

# --- Zeus (VoiceOps — the business telephone number, and fax) ---------------
# Genesis consumes Zeus's number and fax APIs; it never talks to the carrier.
ZEUS_API_URL=https://app.zeus.innotel.us
ZEUS_API_TOKEN=
# The DID a fax is sent from (`from_did_id` on Zeus): one of the account's own
# numbers with fax enabled. Required to file the EIN by fax.
ZEUS_FAX_FROM_DID_ID=

# --- IRS (the EIN filing — third-party designee) ----------------------------
# The IRS restricts its ONLINE EIN assistant to the entity's responsible party,
# so Genesis files Form SS-4 by fax as the designee the party signed for. It
# transmits only after the responsible party's authorization is recorded and the
# signed copy is on file; it never signs for the applicant.
#
# The fax line depends on the business's principal state. Copy the right row from
# the SS-4 instructions ("Where To File"). Set a single line for every business,
# a per-state table, or both — the table wins for a state it carries.
IRS_EIN_FAX_NUMBER=
# JSON, e.g. {"TX":"+18559990000","DE":"+18559990001"}
IRS_EIN_FAX_BY_STATE=

# --- Oasis (MailOps — the business mailbox on its own domain) ----------------
# Oasis provisions mail with zmprov on the mail host, so there is no API to call
# unless an operator exposes one. Unset = the request is queued for the operator.
OASIS_PROVISION_URL=
OASIS_PROVISION_TOKEN=

# --- Signara (SignOps — signing requests for the generated packets) ----------
# Genesis hands a rendered packet to Signara and opens a signing request; the
# owner signs in Signara. Unset = the packet is still downloadable, but the
# hand-off button is hidden and the route answers 503.
# Machine-to-machine auth is the scoped key (`X-API-Key: sgn_…`).
SIGNARA_API_URL=https://api.signara.innotel.us/api/v1
SIGNARA_API_KEY=
